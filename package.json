{
  "name": "toon-expo-registration",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"messages/**/*.json\" \"e2e/**/*.ts\" \"*.{ts,js,mjs,cjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"messages/**/*.json\" \"e2e/**/*.ts\" \"*.{ts,js,mjs,cjs,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "tickets:backfill": "tsx scripts/backfill-tickets.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "argon2",
      "esbuild",
      "sharp",
      "@swc/core",
      "@parcel/watcher",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@prisma/adapter-neon": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@prisma/client-runtime-utils": "^7.9.0",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "argon2": "^0.45.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "libphonenumber-js": "^1.13.9",
    "next": "^16.2.12",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.13.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "prisma": "^7.9.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "@types/qrcode": "^1.5.6"
  }
}
