# Application
SITE_URL="http://localhost:3000"

# Neon PostgreSQL
# Pooled, least-privilege application connection used at runtime.
DATABASE_URL="postgresql://app_user:password@host-pooler/database?sslmode=require"
# Direct migration connection; do not expose it to the deployed runtime.
DIRECT_URL="postgresql://migration_user:password@host/database?sslmode=require"

# Auth.js
AUTH_SECRET="replace-with-a-generated-high-entropy-secret"

# Local admin seed only (never commit real values; omit in production pipelines)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-local-only-password"

# Resend
RESEND_API_KEY="re_replace_with_resend_api_key"
RESEND_FROM_EMAIL="Toon Expo <hi@mail.toonexpo.com>"

# Dexatel SMS (ticket-link delivery; same Toon Expo Dexatel account)
# Header: X-Dexatel-Key. Sender = `name` from GET /v1/senders (channel SMS, status Available).
DEXATEL_API_KEY="replace-with-dexatel-api-key"
DEXATEL_SMS_FROM="replace-with-sms-sender-name"

# Vercel Cron + manual retries for DeliveryJob (min 32 chars).
# Vercel injects Authorization: Bearer <CRON_SECRET> on scheduled GET.
CRON_SECRET="replace-with-long-random-secret"

# Mootq partner integration (min 32 chars each; separate write vs read scopes)
# MOOTQ_WRITE_KEY="replace-with-long-random-write-key"
# MOOTQ_READ_KEY="replace-with-long-random-read-key"

# Optional later: Mootq full-export endpoint for Toon Expo admin import
# MOOTQ_FULL_EXPORT_BASE_URL="https://mootq.example/api/full-export"
# MOOTQ_FULL_EXPORT_KEY="replace-with-long-random-import-key"

# Optional: Toon Expo → Mootq fast push (outbox). Unset = leave PartnerPushDelivery PENDING.
# MOOTQ_PUSH_URL="https://mootq.example/api/v1/integrations/toon-expo/registrations"
# MOOTQ_PUSH_KEY="replace-with-long-random-push-key-min-32-chars"
